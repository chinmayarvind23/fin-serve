{
  "name": "finserve",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test apps/api && bun test apps/web",
    "lint": "biome check apps/api apps/web",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:edge && bun run build:web",
    "build:edge": "bun build apps/api/server.ts --target=bun --outdir=dist/api",
    "build:web": "bun build apps/web/server.ts --target=bun --outdir=dist/web",
    "start:edge": "bun apps/api/server.ts",
    "start:web": "bun apps/web/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@happy-dom/global-registrator": "20.14.3",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
