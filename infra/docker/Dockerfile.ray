# CPU routing actors connect to separately managed GPU engines over bounded HTTP.
FROM ghcr.io/astral-sh/uv:0.8.4@sha256:40775a79214294fb51d097c9117592f193bcfdfc634f4daa0e169ee965b10ef0 AS uv
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS build
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra distributed --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --extra distributed --no-editable

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ARG SOURCE_REVISION=unrecorded
LABEL org.opencontainers.image.source="https://github.com/chinmayarvind23/fin-serve"
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV FINSERVE_REVISION=$SOURCE_REVISION
# KubeRay invokes Bash and its documented process probes use wget.
RUN apt-get update && apt-get install -y --no-install-recommends bash wget ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 finserve && useradd --uid 1000 --gid finserve --create-home finserve
WORKDIR /app
COPY --from=build --chown=1000:1000 /app/.venv /app/.venv
USER 1000:1000
EXPOSE 6379 8000 8265
CMD ["ray", "start", "--head", "--num-gpus=0", "--dashboard-host=0.0.0.0", "--block"]
