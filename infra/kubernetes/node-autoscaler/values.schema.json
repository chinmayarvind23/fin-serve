{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusterName", "awsAccountId", "awsRegion"],
  "properties": {
    "clusterName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,25}$"},
    "awsAccountId": {"type": "string", "pattern": "^[0-9]{12}$"},
    "awsRegion": {"type": "string", "pattern": "^(us|eu|ap|sa|ca|me|af|il|mx)-(east|west|south|north|central|northeast|southeast)-[1-9]$"}
  }
}
